[include]
    path = ~/.gitconfig.user

[commit]
    gpgSign = true

[tag]
    gpgSign = true

[gpg]
    format = ssh

# Own repos (dotfiles and its submodules) always over ssh, so they keep
# working if made private. Everything else is fetched over https (lazy.nvim
# plugins need no key) and pushed over ssh.
[url "git@github.com:ryankish/"]
    insteadOf = https://github.com/ryankish/

[url "git@github.com:"]
    pushInsteadOf = https://github.com/

[core]
    editor = nvim

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
